# --- apps/web (server-side only unless prefixed NEXT_PUBLIC_) ---
DATABASE_URL=postgresql://user:password@localhost:5432/ecora
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=
# Local dev values below are for MinIO. Deploying to Cloudflare R2 (CLAUDE.md
# §13 — see DEPLOY.md): STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# STORAGE_REGION=auto (the literal value R2 requires, not a placeholder).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ecora-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_REGION=us-east-1
NEXT_PUBLIC_MAP_TILE_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_TOKEN=
INFERENCE_SERVICE_URL=http://localhost:8000

# Email (CLAUDE.md §13 resolved 2026-08-29: Resend). Leave EMAIL_PROVIDER_API_KEY
# unset in local dev to fall back to a console-log transport — see apps/web/lib/email/.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Ecora <no-reply@ecora.example>

# --- services/inference ---
# Local dev defaults to the .pt runtime. The Hugging Face Spaces / Render
# deployment (DEPLOY.md) uses YOLO_RUNTIME=onnx + best.onnx instead — CPU-only
# free tiers, and CLAUDE.md §6 calls .onnx the lighter-weight option; already
# the default baked into services/inference/Dockerfile.
YOLO_MODEL_PATH=./models/best.pt
YOLO_RUNTIME=pt
MODEL_VERSION=yolo26s-underwater-v1
